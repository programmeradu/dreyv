{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreyv",
  "main": "workers/cf-proxy/index.ts",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "NextAppContainer",
      "image": "./Dockerfile",
      "instance_type": "standard",
      "min_instances": 1,
      "ssh": {
        "enabled": true
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_APP",
        "class_name": "NextAppContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NextAppContainer"]
    }
  ],
  "routes": [
    { "pattern": "dreyv.com", "custom_domain": true }
  ]
}
