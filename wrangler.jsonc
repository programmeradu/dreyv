{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreyv",
  "main": "workers/cf-proxy/index.ts",
  "compatibility_date": "2024-09-23",
  "containers": [
    {
      "class_name": "NextAppContainer",
      "image": "./Dockerfile"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_APP",
        "class_name": "NextAppContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NextAppContainer"]
    }
  ],
  "routes": [
    { "pattern": "dreyv.com", "custom_domain": true }
  ]
}
