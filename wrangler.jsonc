{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreyv",
  "main": "workers/cf-proxy/index.ts",
  "compatibility_date": "2024-09-23",
  "containers": [
    {
      "binding": "NEXT_APP",
      "image": "./Dockerfile"
    }
  ],
  "routes": [
    { "pattern": "dreyv.com", "custom_domain": true }
  ]
}
