{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreyv",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "dreyv.com", "custom_domain": true },
    { "pattern": "www.dreyv.com", "custom_domain": true },
    { "pattern": "dreyv.app", "custom_domain": true },
    { "pattern": "www.dreyv.app", "custom_domain": true },
    { "pattern": "dreyv.finance", "custom_domain": true },
    { "pattern": "www.dreyv.finance", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://dreyv.com"
  }
}
